{
    "name": "splat-shq",
    "version": "1.2.9",
    "description": "JavaScript/WebGL2 Gaussian Splatting renderer with 3rd-order SH and QPLY support",
    "main": "dist/index.es.js",
    "module": "dist/index.es.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js",
            "default": "./dist/index.es.js"
        }
    },
    "scripts": {
        "build:wasm": "sh ./compile_wasm.sh",
        "copy:wasm": "mkdir -p dist/wasm && cp src/wasm/*.wasm dist/wasm/ 2>/dev/null || true",
        "build": "npm run build:wasm && vite build && npm run copy:wasm",
        "dev": "vite",
        "serve": "npx http-server . --cors --gzip -p 3000",
        "dev:throttled": "set THROTTLE_SPEED=20 && vite --host",
        "dev:3g": "set THROTTLE_SPEED=2 && vite --host",
    "preview": "vite preview",
        "test": "vitest run",
        "lint": "eslint \"*.ts\" \"src/**/*.ts\" \"examples/**/*.ts\"",
        "format": "prettier --write \"*.ts\" \"src/**/*.ts\" \"examples/**/*.ts\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/YOUR_USERNAME/splat-shq.js.git"
    },
    "keywords": [
        "splat-shq",
        "gsplat",
        "gaussian splatting",
        "spherical harmonics",
        "qply",
        "quantized",
        "javascript",
        "3d",
        "webgl2"
    ],
    "author": "YOUR_NAME",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/YOUR_USERNAME/splat-shq.js/issues"
    },
    "homepage": "https://github.com/YOUR_USERNAME/splat-shq.js#readme",
    "devDependencies": {
        "@types/compression": "^1.8.1",
        "@types/node": "^24.0.13",
        "@typescript-eslint/eslint-plugin": "^8.36.0",
        "@typescript-eslint/parser": "^8.36.0",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "eslint": "^9.31.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.5.1",
        "express": "^5.2.1",
        "glob": "^11.0.3",
        "prettier": "^3.6.2",
        "throttle": "^1.0.3",
        "tslib": "^2.8.1",
        "typescript": "^5.7.2",
        "vite": "^5.0.0",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-dts": "^4.3.0",
        "vite-plugin-static-copy": "^1.0.6",
        "vite-plugin-top-level-await": "^1.5.0",
        "vite-plugin-wasm": "^3.5.0",
        "vitest": "^4.1.10"
    },
    "files": [
        "dist/**/*"
    ]
}
